<Project Sdk="Microsoft.NET.Sdk">
  <!-- SengenWinUI3 の部品を出して動かす見本のアプリ。パッケージにせず、Windows App SDK を自分の中に持つ。XAML のファイルを使わない -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <RootNamespace>Gallery</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SengenWinUI3/SengenWinUI3.csproj" />
  </ItemGroup>
</Project>
